# SQLAlchemy connection string used by SQLAlchemy / Alembic.
# Defaults to a local SQLite file — no separate database server needed.
# Point this at a real Postgres URL instead if you want one, e.g.:
#   postgresql+psycopg2://postgres:postgres@localhost:5432/treasurehunts
DATABASE_URL=sqlite:///./treasurehunts.db

# Google Gemini API key (https://aistudio.google.com/apikey). Required for
# POST /api/ai/generate and POST /api/ai/regenerate-clue.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Read-only JSON-RPC endpoint used to verify a hunt's on-chain creator when
# publishing metadata. Point this at your local Anvil node, a testnet, or
# mainnet RPC depending on where TreasureHunt.sol is deployed.
RPC_URL=http://localhost:8545

# Address of the deployed TreasureHunt contract.
TREASURE_HUNT_ADDRESS=

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:5173
