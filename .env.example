# ─────────────────────────────────────────────────────────────────────────────
# Internet Treasure Hunts — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# All VITE_* variables are bundled into the client — do not put secrets here.

# WalletConnect Project ID (get one at https://cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Deployed contract addresses
# After running: forge script script/Deploy.s.sol --broadcast
# These are set automatically from deployment.json — override here if needed.
VITE_TREASURE_HUNT_CONTRACT=0x0000000000000000000000000000000000000000
VITE_TREASURE_NFT_CONTRACT=0x0000000000000000000000000000000000000000

# Chain + RPC
# Local Anvil:   VITE_CHAIN_ID=31337  VITE_RPC_URL=http://localhost:8545
# Sepolia:       VITE_CHAIN_ID=11155111
VITE_CHAIN_ID=31337
VITE_RPC_URL=http://localhost:8545

# ENS RPC (must be Ethereum mainnet for ENS to resolve)
VITE_ENS_RPC_URL=https://eth.llamarpc.com

# The Graph subgraph endpoint
# Deploy your subgraph at https://thegraph.com/studio/ then paste the query URL
VITE_SUBGRAPH_URL=https://api.studio.thegraph.com/query/YOUR_ID/internet-treasure-hunts/v0.0.1

# AI backend base URL (optional — leave blank to use the built-in demo generator)
# When set, POST /api/ai/generate and POST /api/ai/regenerate-clue are called.
VITE_AI_API=

# ── Contracts / Foundry ───────────────────────────────────────────────────────
# Used by forge scripts — NOT bundled into the frontend.

# Deployer private key (never commit this)
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Chainlink VRF (Sepolia)
# See https://docs.chain.link/vrf/v2/subscription/supported-networks
VRF_COORDINATOR=0x8103B0A8A00be2DDC778e6e7eaa21791Cd364625
VRF_KEY_HASH=0x474e34a077df58807dbe9c96d3c009b23b3c6d0cce433e59bbf5b34f823bc56c
VRF_SUBSCRIPTION_ID=1

# Fee recipient (address that receives the 2.5% platform fee)
FEE_RECIPIENT=0xYourFeeRecipientAddress

# Etherscan (for contract verification)
ETHERSCAN_API_KEY=your_etherscan_api_key

# Sepolia RPC (Infura, Alchemy, or public)
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# ── The Graph (subgraph deployment) ──────────────────────────────────────────
# Used when running: graph deploy
GRAPH_ACCESS_TOKEN=your_graph_access_token
GRAPH_DEPLOY_KEY=your_graph_deploy_key
