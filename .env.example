# ─────────────────────────────────────────────────────────────────────────────
# Internet Treasure Hunts — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# All VITE_* variables are bundled into the client — do not put secrets here.

# WalletConnect Project ID (get one at https://cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Deployed contract addresses
# After running: forge script script/Deploy.s.sol --broadcast
# These are set automatically from deployment.json — override here if needed.
VITE_TREASURE_HUNT_CONTRACT=0x0000000000000000000000000000000000000000
VITE_TREASURE_NFT_CONTRACT=0x0000000000000000000000000000000000000000

# Chain + RPC
# Local Anvil:   VITE_CHAIN_ID=31337  VITE_RPC_URL=http://localhost:8545
# Sepolia:       VITE_CHAIN_ID=11155111
VITE_CHAIN_ID=31337
VITE_RPC_URL=http://localhost:8545

# ENS RPC (must be Ethereum mainnet for ENS v1 name/avatar resolution)
VITE_ENS_RPC_URL=https://eth.llamarpc.com

# ENSv2 Sepolia RPC (separate from the app RPC — ENSv2 Beta lives on Sepolia)
# ──────────────────────────────────────────────────────────────────────────────
# Used by the ENSv2 subname service (services/ensSubnames.ts) to read live
# resolver records from the PermissionedResolverImpl on Sepolia.
# Can be the same as SEPOLIA_RPC_URL below, or a dedicated provider URL.
#
# ENSv2 Sepolia Beta contract addresses (source: https://docs.ens.domains/learn/deployments/):
#   ETHRegistry:             0xbdc85dd5b15d7ecb354cd7cb6f2c50b4f2c4f0e2
#   PermissionedResolver:    0x9eae5c2730a7dd16bdd1dee6421a1b91e3b0365e
#   PublicResolverV2:        0xe7b9a25607e02da8145e4eb1836ca539e53f11f7
#   UniversalResolver:       0xeEeEEEeE14D718C2B47D9923Deab1335E144EeEe
#   UserRegistryImpl:        0x624a25d67b59d587752ebec8dded8827dae52050
#   VerifiableFactory:       0x10dc6333cdfe1fcef624c6e0a8221b91804cd7ef
#   RootRegistry:            0x8115186e8f2e0b0281e86ab91f0f48ba90364354
#
# Namespace layout:
#   Platform:  treasurehunts.eth
#   Brand:     {slug}.treasurehunts.eth           ← owned by brand wallet
#   Hunt:      hunt-{id}.{slug}.treasurehunts.eth  ← registered per hunt
#   AI Agent:  agent-{id}.{slug}.treasurehunts.eth ← WRITER_ROLE delegated
VITE_ENS_SEPOLIA_RPC_URL=https://rpc.sepolia.org

# The Graph subgraph endpoint
# ──────────────────────────────────────────────────────────────────────────────
# Deploy your subgraph to Subgraph Studio, then paste the "Query URL" here.
#
# Steps:
#   1. Go to https://thegraph.com/studio/ and create a subgraph named
#      "internet-treasure-hunts"
#   2. Deploy: graph deploy --studio internet-treasure-hunts
#      (uses GRAPH_DEPLOY_KEY below)
#   3. Copy the "Query URL" from the studio dashboard and paste it below.
#      It looks like:
#      https://api.studio.thegraph.com/query/<USER_ID>/internet-treasure-hunts/v0.0.1
#
# IMPORTANT for the AI generation pipeline:
#   This URL is queried LIVE before every AI hunt generation to pull
#   platform analytics (completion rates, prize distributions, clue counts).
#   The AI uses this on-chain data to recommend prize, difficulty, and
#   clue count — making The Graph a load-bearing part of the AI flow.
VITE_SUBGRAPH_URL=https://api.studio.thegraph.com/query/YOUR_STUDIO_ID/internet-treasure-hunts/v0.0.1

# The Graph API key (required for decentralised network queries)
# ──────────────────────────────────────────────────────────────────────────────
# Only needed if you're querying through The Graph's decentralised network
# (api.thegraph.com/subgraphs/...) rather than Subgraph Studio.
# Get an API key at https://thegraph.com/studio/ → API Keys tab.
# Leave blank when using Subgraph Studio hosted-service URLs above.
VITE_GRAPH_API_KEY=

# AI backend base URL (optional — leave blank to use the built-in demo generator)
# When set, POST /api/ai/generate and POST /api/ai/regenerate-clue are called.
VITE_AI_API=

# ── Contracts / Foundry ───────────────────────────────────────────────────────
# Used by forge scripts — NOT bundled into the frontend.

# Deployer private key (never commit this)
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Chainlink VRF (Sepolia)
# See https://docs.chain.link/vrf/v2/subscription/supported-networks
VRF_COORDINATOR=0x8103B0A8A00be2DDC778e6e7eaa21791Cd364625
VRF_KEY_HASH=0x474e34a077df58807dbe9c96d3c009b23b3c6d0cce433e59bbf5b34f823bc56c
VRF_SUBSCRIPTION_ID=1

# Fee recipient (address that receives the 2.5% platform fee)
FEE_RECIPIENT=0xYourFeeRecipientAddress

# Etherscan (for contract verification)
ETHERSCAN_API_KEY=your_etherscan_api_key

# Sepolia RPC (Infura, Alchemy, or public)
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# ── The Graph (subgraph deployment) ──────────────────────────────────────────
# Used when running: graph deploy --studio internet-treasure-hunts
#
# Get your deploy key from https://thegraph.com/studio/ → your subgraph →
# "Deploy" tab. This is a write key, not the query API key above.
GRAPH_ACCESS_TOKEN=your_graph_access_token
GRAPH_DEPLOY_KEY=your_graph_deploy_key
